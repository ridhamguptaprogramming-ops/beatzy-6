{
  "extends": "../../tsconfig.base.json",

  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "declaration": true,
    "sourceMap": true,

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "skipLibCheck": true,

    "noEmit": false
  },

  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}